---
// methodproduction.com: tools/build.py's hub() at content parity, with the motion islands.
import Hub from "../layouts/Hub.astro";
import Picture from "../components/Picture.astro";
import SuiteBar from "../components/SuiteBar.astro";
import SuiteBand from "../components/SuiteBand.astro";
import AppCard from "../components/AppCard.astro";
import Ships from "../components/Ships.astro";
import HeroStack from "../components/HeroStack.astro";
import AppTiles from "../components/AppTiles.astro";
import Story from "../components/islands/Story";
import { BlurFade } from "../components/vendor/magicui/blur-fade";
import { APPS, LAUNCHER_DMG, SUITE, pageUrl } from "../data/catalog";

const story = APPS.map(({ slug, name, does, tagline, accent }) => ({ slug, name, does, tagline, accent }));
---
<Hub title={SUITE.name} description={SUITE.lede} canonical={`https://${SUITE.domain}/`}>
<a class="skip" href="#main">Skip to content</a>
<SuiteBar current={null} sticky />
<main id="main">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1><Picture light="/_suite/brand/suite/wordmark.svg" dark="/_suite/brand/suite/wordmark-dark.svg" alt={SUITE.name} class="hub-wm" width={640} height={52} /></h1>
        <p class="pitch mission">{SUITE.mission}</p>
        <p class="subpitch">{SUITE.pitch}</p>
        <p class="lede">{SUITE.lede}</p>
        <p class="hero-cta">
          <a class="btn primary launcher-btn" href={LAUNCHER_DMG}>Get all four apps for Mac</a>
          <span class="hero-cta-note">One download: <a href={pageUrl("launcher")}>Method Launcher</a> installs the apps you want and keeps them up to date. Or pick one below.</span>
        </p>
      </div>
      <HeroStack />
    </div>
    <div class="wrap">
      <AppTiles />
      <p class="pages-nav"><a href={pageUrl("why")}>Why this exists</a>
        <a href={pageUrl("how")}>How it's built</a> <a href={pageUrl("help")}>Help build it</a></p>
    </div>
  </section>
  <Story client:visible={{ rootMargin: "400px" }} apps={story} />
  <section class="band alt" aria-labelledby="apps-h"><div class="wrap">
    <h2 id="apps-h">The apps</h2>
    <p class="sample-line"><strong>Try it on a sample production.</strong> Method Storyteller, Method Schedule and
      Method Budget come with the same invented production, an 18-day independent feature, so you can see
      the suite working before you open your own work. Help &gt; Open Sample in each, or Demo the suite in{" "}
      <a href={pageUrl("launcher")}>Method Launcher</a>.</p>
    <div class="app-grid">{APPS.map((a) => <AppCard app={a} />)}</div>
  </div></section>
  <section class="band" aria-labelledby="ships-h"><div class="wrap ships">
    <h2 id="ships-h">Hear about new releases</h2>
    <p><Ships />{" "}
      Want to help? <a href={pageUrl("help")}>Here's how</a>, film knowledge or code.</p>
  </div></section>
  <section class="band alt" aria-labelledby="open-h"><div class="wrap">
    <h2 id="open-h">Open, all the way down</h2>
    <div class="cards three">
      <BlurFade client:visible className="card"><h3>Your computer, your files</h3><p>Every app runs on your own machine and works offline. Nothing about your production is uploaded anywhere.</p></BlurFade>
      <BlurFade client:visible className="card" delay={0.08}><h3>Open formats</h3><p>Scripts are Open Screenplay Format or Fountain, budgets and schedules are documented text files you can read, diff and keep in version control.</p></BlurFade>
      <BlurFade client:visible className="card" delay={0.16}><h3>Free and open source</h3><p>MIT or Apache-2.0, on GitHub, with every decision written down in each repo.</p></BlurFade>
    </div>
  </div></section>
</main>
<SuiteBand />
</Hub>
