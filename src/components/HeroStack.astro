---
// The hero's stack: one page per app, in the suite mark's colors, that fans out as you
// scroll away. Browsers with scroll-driven CSS animations do it in CSS (hub-motion.css);
// the small script below drives the same transforms by hand in browsers without them.
// Nothing moves for people who ask for reduced motion, and the static stack is complete.
// Plain Astro, not a React island: it's above the fold, and React can wait for the story.
import { APPS } from "../data/catalog";

// Where each page rests in the stack and where it lands, fanned out: x and y in percent of
// the page, r in degrees. The first app is on top.
const REST = [{ x: -6, y: -4, r: -3 }, { x: 4, y: -2, r: 2 }, { x: -2, y: 3, r: -1 }, { x: 5, y: 5, r: 3 }];
const FAN = [{ x: -38, y: -18, r: -9 }, { x: 34, y: -22, r: 7 }, { x: -30, y: 24, r: 5 }, { x: 36, y: 20, r: -6 }];
const pose = (p: { x: number; y: number; r: number }) => `translate(${p.x}%, ${p.y}%) rotate(${p.r}deg)`;
const sheets = APPS.map((a, i) => ({ a, i })).reverse();
---
<div class="stack" aria-hidden="true" data-hero-stack>
  {sheets.map(({ a, i }) => (
    <div class="sheet" data-rest={JSON.stringify(REST[i % 4])} data-fan={JSON.stringify(FAN[i % 4])}
         style={`--app-accent:${a.accent[0]};--app-accent-dark:${a.accent[1]};--rest:${pose(REST[i % 4])};--fan:${pose(FAN[i % 4])}`}>
      <span>{a.does}</span>
    </div>
  ))}
</div>
<script>
  // Only where CSS can't tie an animation to the scroll.
  if (!CSS.supports("animation-timeline: scroll()")) {
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    const sheets = [...document.querySelectorAll<HTMLElement>("[data-hero-stack] .sheet")].map((el) => ({
      el, a: JSON.parse(el.dataset.rest!), b: JSON.parse(el.dataset.fan!) }));
    let frame = 0;
    const draw = () => {
      frame = 0;
      const t = still.matches ? 0 : Math.min(1, Math.max(0, scrollY / (innerHeight * 0.6)));
      const e = t * t * (3 - 2 * t);
      for (const { el, a, b } of sheets) {
        el.style.transform = `translate(${a.x + (b.x - a.x) * e}%, ${a.y + (b.y - a.y) * e}%) rotate(${a.r + (b.r - a.r) * e}deg)`;
      }
    };
    addEventListener("scroll", () => { if (!frame) frame = requestAnimationFrame(draw); }, { passive: true });
    still.addEventListener("change", draw);
    draw();
  }
</script>
